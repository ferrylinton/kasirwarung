# Application Configuration
PORT=3000
APP_URL=http://localhost:3000

# Authentication
JWT_SECRET=kasirwarung-jwt-supersecret-2026
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=1d
# Auto-Logout Inactivity Period (Default: 5 minutes)
IDLE_TIMEOUT_MINUTES=5
VITE_IDLE_TIMEOUT_MINUTES=5

# Database & Cache (Optional - In-Memory MongoDB & Token Bucket fallbacks are active by default)
MONGODB_URI=
REDIS_URL=

# SMTP Email Configuration (Optional - Verification tokens and links are shown in UI)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=KasirWarung <noreply@example.com>

# Server-Side Gemini API Key (Optional)
GEMINI_API_KEY=
